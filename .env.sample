# ---------------------------------------------------------------------------
# Indusense - configuration locale de developpement
#
# ATTENTION : ce fichier est versionne et contient des identifiants de
# developpement. Ne jamais y placer de secret de production.
# Les valeurs de ce fichier sont lues a la fois par docker compose (pour les
# variables d'infrastructure) et par pydantic-settings (pour l'application).
# ---------------------------------------------------------------------------

## ---- PostgreSQL ----

## Image tag (le tiret initial rompait le tag : "postgres:-15.1")
DB_TAG=15.1

## Port hote. 5433 est deja occupe par un autre projet sur ce poste.
DB_PORT=5434

## Nom de la base
DB_NAME=indusense_db

## Utilisateur
DB_USER=indusense_user

## Mot de passe
DB_PASSWORD=ThePassword4Indusense

## Volume de donnees (utilise par docker-compose.yml)
DB_DATA_VOLUME=pg-db-data

## ---- PgAdmin4 ----

GUI_TAG=6.15
GUI_DATA_VOLUME=pg-gui-data

## Port web de PgAdmin (expose sur 127.0.0.1 uniquement)
GUI_PORT=8081

## Identifiants PgAdmin (le separateur doit etre "=" et non ":")
GUI_EMAIL=mylogin@mydomain.org
GUI_PASSWORD=mypassword

## ---- Application ----

## Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

## URL SQLAlchemy complete, prioritaire sur les variables DB_* si renseignee.
## Laissez vide pour la construire automatiquement a partir de DB_*.
# DATABASE_URL=postgresql+psycopg://user:pass@host:port/db

## ---- Anonymisation ----

## Sel de hachage des donnees personnelles (silver). Valeur de DEVELOPPEMENT :
## une vraie installation doit fournir son propre sel, jamais versionne.
ANONYMISATION_SALT=dev-salt-indusense-change-me

## ---- API de service (FastAPI) ----

## Bind local par defaut : un modele de developpement n'a pas a etre joignable
## depuis le reseau sans decision explicite.
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1

## Repertoire des artefacts de service (champion gele + reference).
SERVING_DIR=artifacts/serving

## Historique brut conserve par machine (heures). Le modele a besoin de 25 h.
SERVING_HISTORY_HOURS=168

## Une lecture datee de plus de N secondes dans le futur est refusee.
SERVING_MAX_FUTURE_SKEW_SECONDS=300

## Budget d'alertes valide avec l'atelier (alertes / machine / semaine).
ALERT_BUDGET_PER_MACHINE_WEEK=1.0

## ---- Monitoring de derive ----

## Fenetre glissante et nombre minimal d'observations pour un PSI.
DRIFT_WINDOW_SIZE=5000
DRIFT_MIN_SAMPLES=100
DRIFT_MIN_MACHINES=5
DRIFT_CHECK_INTERVAL_SECONDS=300

## Seuils PSI (convention : < 0.10 stable, 0.10-0.25 a surveiller, > 0.25 derive).
DRIFT_PSI_WARNING=0.10
DRIFT_PSI_ALERT=0.25
DRIFT_ALERT_COOLDOWN_SECONDS=3600

## Nombre minimal d'evenements de feedback avant de publier un rappel exploitable.
PERFORMANCE_MIN_EVENTS=5
PERFORMANCE_RECALL_FLOOR=0.5

## ---- Monitoring d'infrastructure (docker compose) ----
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=indusense
GRAFANA_DATA_VOLUME=grafana-data
PROMETHEUS_DATA_VOLUME=prometheus-data
ALERTMANAGER_DATA_VOLUME=alertmanager-data
